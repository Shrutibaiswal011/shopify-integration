{% stylesheet %}

.hero-slider {
  position: relative;
  overflow: hidden;
}

.slide {
  position: relative;
  display: none;
}

.slide.active {
  display: block;
}

.slide img {
  width: 100%;
  height: 520px;
  object-fit: cover;
}

.slide-content {
  position: absolute;
  top: 50%;
  right: 10%;
  transform: translateY(-50%);
  color: white;
  max-width: 400px;
}

.slide-content h2 {
  font-size: 48px;
  font-weight: 600;
}

.slide-content p {
  margin: 15px 0;
}

.slider-dots{
position:absolute;
bottom:20px;
left:50%;
transform:translateX(-50%);
display:flex;
gap:8px;
}

.slider-dots span{
width:30px;
height:4px;
background:#ffffff66;
cursor:pointer;
transition:.3s;
}

.slider-dots span.active{
background:white;
}

/* .slide-content a {
  background: black;
  color: white;
  padding: 12px 28px;
  text-decoration: none;
} */

@media(max-width:768px){

.slide img {
  height: 380px;
}

.slide-content {
  right: 5%;
}

.slide-content h2 {
  font-size: 28px;
}

}

{% endstylesheet %}


<div class="hero-slider">

{% for block in section.blocks %}

<div class="slide {% if forloop.first %}active{% endif %}">

<img
src="{{ block.settings.image | image_url }}"
alt="banner"
>

<div class="slide-content">

<h2>{{ block.settings.heading }}</h2>

<p>{{ block.settings.subheading }}</p>

<a href="{{ block.settings.btn_link }}">

{{ block.settings.btn_text }}

</a>

</div>

</div>

{% endfor %}
<div class="slider-dots">

{% for block in section.blocks %}

<span data-index="{{ forloop.index0 }}"></span>

{% endfor %}

</div>
</div>


<script>

let slides=document.querySelectorAll(".slide")
let dots=document.querySelectorAll(".slider-dots span")

let index=0

function showSlide(i){

slides.forEach(slide=>slide.classList.remove("active"))
dots.forEach(dot=>dot.classList.remove("active"))

slides[i].classList.add("active")
dots[i].classList.add("active")

index=i

}


// manual dots click support

dots.forEach((dot,i)=>{

dot.addEventListener("click",()=>{

showSlide(i)

})

})


// autoplay only if enabled from editor

{% if section.settings.autoplay %}

function autoSlide(){

index++

if(index>=slides.length){

index=0

}

showSlide(index)

}

setInterval(autoSlide, {{ section.settings.speed }}000)

{% endif %}


// first slide active

showSlide(0)

</script>


{% schema %}
{
  "name": "Custom Hero Slider",
  "settings": [
    {
"type": "checkbox",
"id": "autoplay",
"label": "Enable autoplay",
"default": true
},
{
"type": "range",
"id": "speed",
"min": 2,
"max": 10,
"step": 1,
"unit": "sec",
"label": "Autoplay speed",
"default": 4
}
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Banner Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading"
        },
        {
          "type": "text",
          "id": "btn_text",
          "label": "Button Text",
          "default": "SHOP NOW"
        },
        {
          "type": "url",
          "id": "btn_link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Hero Slider"
    }
  ]
}
{% endschema %}