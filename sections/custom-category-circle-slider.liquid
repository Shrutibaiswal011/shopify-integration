{% stylesheet %}

.circle-slider {
  display:flex;
  gap:30px;
  padding:20px 0;
  justify-content:center;
  flex-wrap:wrap;
}

@media(max-width:768px){
  .circle-slider{
    overflow-x:auto;
    flex-wrap:nowrap;
    justify-content:flex-start;
  }
}

.circle-item {
  text-align:center;
  min-width:120px;
}

.circle-img {
  width:110px;
  height:110px;
  border-radius:50%;
  padding:3px;
  background:linear-gradient(45deg,#ff4d6d,#ff758f);
}

.circle-img img {
  width:100%;
  height:100%;
  border-radius:50%;
  object-fit:cover;
}

.circle-title {
  margin-top:10px;
  font-size:14px;
}

.badge-new {
  position:absolute;
  background:red;
  color:white;
  font-size:10px;
  padding:3px 6px;
  border-radius:10px;
  top:-5px;
  right:-5px;
}

.circle-wrapper {
  position:relative;
  display:inline-block;
}

.circle-slider::-webkit-scrollbar {
  display:none;
}

{% endstylesheet %}


<div class="page-width">

<div class="circle-slider">

{% for block in section.blocks %}

<div class="circle-item">

<a href="{{ block.settings.link }}">

<div class="circle-wrapper">

{% if block.settings.show_badge %}
<span class="badge-new">NEW</span>
{% endif %}

<div class="circle-img">

<img
src="{{ block.settings.image | image_url }}"
alt="{{ block.settings.title }}"
>

</div>

</div>

</a>

<div class="circle-title">

{{ block.settings.title }}

</div>

</div>

{% endfor %}

</div>

</div>


{% schema %}
{
  "name": "Circle Category Slider",
  "settings": [],
  "blocks": [
    {
      "type": "category",
      "name": "Category Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Category Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Category Title"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Category Link"
        },
        {
          "type": "checkbox",
          "id": "show_badge",
          "label": "Show NEW badge"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Circle Category Slider"
    }
  ]
}
{% endschema %}